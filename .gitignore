########################################
# 🛠️ Terraform
########################################
.terraform/
*.tfstate
*.tfstate.backup
*.tfplan
*.backup
# .terraform.lock.hcl is committed (overrides global ignore): provider pins are part of the reproducibility contract
!.terraform.lock.hcl
.terraform.tfstate.lock.info
terraform.tfstate.d/
*.log
crash.log
justfile
# tfvars often carry real credentials — commit .tfvars.example instead
*.tfvars
!*.tfvars.example
!*.tfvars.sample

