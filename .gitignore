# ── Added by commit_gh --harden ─────────────────────────────
*.env
.vault.*
*.vault
*.jsonl
input/*
!input/.gitkeep
output/*
!output/.gitkeep

########################################
# 🌸 F-Ray-grance
########################################
# Keep the canonical state record addable; ignore other new state files.
!/state/BUILD_STATE.json
state/.run.lock/
state/*.tmp
state/.*.tmp
# Manual PostgreSQL backups live OUTSIDE the repo and the Podman VM; guard anyway
backups/
*.dump
*.pgdump
*.backup.manifest.json
# Vault Agent rendered material and AppRole bootstrap files
.vault-agent/
vault-agent-sink*
role-id
secret-id
*.role_id
*.secret_id
# Owner bootstrap secrets (never in Git)
owner-bootstrap*
# Release bundle archives
*.zip
# Nuxt build caches inside workspaces
apps/web/node_modules/.cache/

# impeccable working files (review captures are regenerated by e2e/design-review.spec.ts)
apps/web/.impeccable/review/
apps/web/.impeccable/questions/
